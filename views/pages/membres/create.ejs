<%- include('../../partials/header') %>

<div class="page-header">
    <h1 class="page-title">Nouveau membre</h1>
    <a href="/membres" class="btn-back">← Retour</a>
</div>

<div class="card" style="max-width:780px">
    <form method="POST" action="/membres">
        <div class="form-grid">

            <div class="form-group">
                <label for="prenom">Prénom</label>
                <input type="text" id="prenom" name="prenom" placeholder="ex: Alice" required>
            </div>

            <div class="form-group">
                <label for="nom">Nom</label>
                <input type="text" id="nom" name="nom" placeholder="ex: Dupont" required>
            </div>

            <div class="form-group">
                <label for="date_naissance">Date de naissance</label>
                <input type="date" id="date_naissance" name="date_naissance" required>
            </div>

            <div class="form-group">
                <label for="famille_id">Famille (ID)</label>
                <input type="number" id="famille_id" name="famille_id" min="1" placeholder="ex: 1" required>
            </div>

            <div class="form-group">
                <label>Résidence</label>
                <div class="checkbox-group">
                    <input type="checkbox" id="est_resident" name="est_resident" value="true">
                    <label for="est_resident">Le membre est résident</label>
                </div>
            </div>

            <div class="form-group">
                <label for="code_pass_sport">Code Pass'Sport</label>
                <input type="text" id="code_pass_sport" name="code_pass_sport" placeholder="Optionnel">
            </div>

        </div>

        <div class="section-divider"></div>

        <fieldset>
            <legend>Certificat médical</legend>
            <div class="form-grid" style="margin-top:1rem">
                <div class="form-group">
                    <label for="date_emission_certificat">Date d'émission</label>
                    <input type="date" id="date_emission_certificat" name="date_emission_certificat">
                </div>
                <div class="form-group">
                    <label for="date_expiration_certificat">Date d'expiration</label>
                    <input type="date" id="date_expiration_certificat" name="date_expiration_certificat">
                </div>
                <div class="form-group">
                    <label for="type_sport_certifie">Type de sport certifié</label>
                    <input type="text" id="type_sport_certifie" name="type_sport_certifie" placeholder="ex: natation">
                </div>
                <div class="form-group">
                    <label for="statut_certificat">Statut du certificat</label>
                    <select id="statut_certificat" name="statut_certificat">
                        <option value="">— Aucun —</option>
                        <option value="valide">Valide</option>
                        <option value="expire">Expiré</option>
                        <option value="refuse">Refusé</option>
                        <option value="medical_non_compliant">Non conforme</option>
                    </select>
                </div>
            </div>
        </fieldset>

        <div class="section-divider"></div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Créer le membre</button>
            <a href="/membres" class="btn btn-ghost">Annuler</a>
        </div>
    </form>
</div>

<%- include('../../partials/footer') %>
