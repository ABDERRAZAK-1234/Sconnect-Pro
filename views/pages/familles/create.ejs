<%- include('../../partials/header') %>

<div class="page-header">
    <h1 class="page-title">Nouvelle famille</h1>
    <a href="/familles" class="btn-back">← Retour</a>
</div>

<div class="card form-card">
    <form method="POST" action="/familles">
        <div class="form-grid">

            <div class="form-group">
                <label for="nom_famille">Nom de famille</label>
                <input type="text" id="nom_famille" name="nom_famille" placeholder="ex: Dupont" required>
            </div>

            <div class="form-group">
                <label for="quotient_familial">Quotient familial</label>
                <input type="number" id="quotient_familial" name="quotient_familial" min="0" step="0.01" placeholder="Optionnel">
            </div>

        </div>

        <div class="section-divider"></div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Créer la famille</button>
            <a href="/familles" class="btn btn-ghost">Annuler</a>
        </div>
    </form>
</div>

<%- include('../../partials/footer') %>
