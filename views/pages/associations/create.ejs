<%- include('../../partials/header') %>

<div class="page-header">
    <h1 class="page-title">Nouvelle association</h1>
    <a href="/associations" class="btn-back">← Retour</a>
</div>

<div class="card form-card">
    <form method="POST" action="/associations">
        <div class="form-grid">

            <div class="form-group">
                <label for="nom">Nom de l'association</label>
                <input type="text" id="nom" name="nom" placeholder="ex: Club Athlétique Municipal" required>
            </div>

            <div class="form-group">
                <label for="contact">Contact</label>
                <input type="text" id="contact" name="contact" placeholder="email, téléphone...">
            </div>

            <div class="form-group full-width">
                <label for="description">Description</label>
                <textarea id="description" name="description" placeholder="Décrivez l'association..."></textarea>
            </div>

        </div>

        <div class="section-divider"></div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Créer l'association</button>
            <a href="/associations" class="btn btn-ghost">Annuler</a>
        </div>
    </form>
</div>

<%- include('../../partials/footer') %>
