<%- include('../../partials/header') %>

<div class="page-header">
    <h1 class="page-title">Nouvelle infrastructure</h1>
    <a href="/facilities" class="btn-back">← Retour</a>
</div>

<div class="card form-card">
    <form method="POST" action="/facilities">
        <div class="form-grid">

            <div class="form-group">
                <label for="nom">Nom</label>
                <input type="text" id="nom" name="nom" placeholder="ex: Gymnase municipal" required>
            </div>

            <div class="form-group">
                <label for="type">Type</label>
                <input type="text" id="type" name="type" placeholder="ex: gymnase, piscine, terrain..." required>
            </div>

            <div class="form-group">
                <label for="capacite_erp">Capacité ERP</label>
                <input type="number" id="capacite_erp" name="capacite_erp" min="1" placeholder="ex: 200" required>
            </div>

            <div class="form-group">
                <label>Divisible</label>
                <div class="checkbox-group">
                    <input type="checkbox" id="divisible" name="divisible" value="true">
                    <label for="divisible">Oui, la salle est divisible</label>
                </div>
            </div>

        </div>

        <div class="section-divider"></div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Créer l'infrastructure</button>
            <a href="/facilities" class="btn btn-ghost">Annuler</a>
        </div>
    </form>
</div>

<%- include('../../partials/footer') %>