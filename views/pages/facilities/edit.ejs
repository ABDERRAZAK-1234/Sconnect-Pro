<%- include('../../partials/header') %>

<div class="page-header">
    <h1 class="page-title">Modifier l'infrastructure</h1>
    <a href="/facilities" class="btn-back">← Retour</a>
</div>

<div class="card form-card">
    <form id="editFacilityForm">
        <div class="form-grid">

            <div class="form-group">
                <label for="nom">Nom</label>
                <input type="text" id="nom" name="nom" value="<%= facility.nom %>" required>
            </div>

            <div class="form-group">
                <label for="type">Type</label>
                <input type="text" id="type" name="type" value="<%= facility.type %>" required>
            </div>

            <div class="form-group">
                <label for="capacite_erp">Capacité ERP</label>
                <input type="number" id="capacite_erp" name="capacite_erp" value="<%= facility.capacite_erp %>" min="1" required>
            </div>

            <div class="form-group">
                <label>Divisible</label>
                <div class="checkbox-group">
                    <input type="checkbox" id="divisible" name="divisible" <%= facility.divisible ? 'checked' : '' %>>
                    <label for="divisible">Oui, la salle est divisible</label>
                </div>
            </div>

        </div>

        <div class="section-divider"></div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="/facilities" class="btn btn-ghost">Annuler</a>
        </div>
    </form>
</div>

<script>
    document.getElementById('editFacilityForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = {
            nom: document.getElementById('nom').value,
            type: document.getElementById('type').value,
            capacite_erp: Number(document.getElementById('capacite_erp').value),
            divisible: document.getElementById('divisible').checked
        };
        const r = await fetch('/facilities/<%= facility.id %>', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (r.ok) {
            window.location.href = '/facilities';
        } else {
            const j = await r.json();
            alert(j.message || 'Erreur lors de la modification');
        }
    });
</script>

<%- include('../../partials/footer') %>