<%- include('../../partials/header') %>

<div class="page-header">
    <h1 class="page-title"><%= facility.nom %></h1>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        <a href="/facilities/<%= facility.id %>/edit" class="btn btn-edit">Modifier</a>
        <button id="btn-delete-facility-<%= facility.id %>" class="btn btn-danger" onclick="deleteFacility(<%= facility.id %>, this)">Supprimer</button>
    </div>
</div>

<div class="card">
    <div class="detail-card">
        <div class="detail-field">
            <div class="detail-label">ID</div>
            <div class="detail-value">#<%= facility.id %></div>
        </div>
        <div class="detail-field">
            <div class="detail-label">Nom</div>
            <div class="detail-value"><%= facility.nom %></div>
        </div>
        <div class="detail-field">
            <div class="detail-label">Type</div>
            <div class="detail-value"><span class="badge badge-primary"><%= facility.type %></span></div>
        </div>
        <div class="detail-field">
            <div class="detail-label">Capacité ERP</div>
            <div class="detail-value"><%= facility.capacite_erp %> places</div>
        </div>
        <div class="detail-field">
            <div class="detail-label">Divisible</div>
            <div class="detail-value">
                <% if (facility.divisible) { %>
                    <span class="badge badge-success">Oui</span>
                <% } else { %>
                    <span class="badge badge-neutral">Non</span>
                <% } %>
            </div>
        </div>
    </div>
</div>

<br>
<a href="/facilities" class="btn-back">← Retour aux infrastructures</a>

<script>
    async function deleteFacility(id, btn) {
        if (!confirm('Supprimer cette infrastructure ?')) return;
        btn.classList.add('loading');
        const r = await fetch(`/facilities/${id}`, { method: 'DELETE' });
        if (r.ok) {
            window.location.href = '/facilities';
        } else {
            const j = await r.json();
            alert(j.message || 'Erreur');
            btn.classList.remove('loading');
        }
    }
</script>

<%- include('../../partials/footer') %>